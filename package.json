{
  "name": "stone-valves-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && wrangler dev",
    "cf:deploy:staging": "SITE_ENV=staging opennextjs-cloudflare build && wrangler deploy --env staging",
    "cf:deploy:production": "opennextjs-cloudflare build && wrangler deploy --env=\"\""
  },
  "dependencies": {
    "next": "^16.3.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "typescript": "^5.9.3",
    "wrangler": "^4.131.2"
  }
}

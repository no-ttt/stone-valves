{
  "name": "stone-valves-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && wrangler dev",
    "cf:deploy:staging": "SITE_ENV=staging opennextjs-cloudflare build && opennextjs-cloudflare deploy --env staging",
    "cf:deploy:production": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env=\"\"",
    "cf:typegen": "wrangler types --env-interface Env",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote --env=\"\"",
    "db:seed:build": "tsx scripts/build-seed.ts",
    "db:seed:local": "wrangler d1 execute DB --local --file=drizzle/seed.sql",
    "db:tagcache:local": "wrangler d1 execute NEXT_TAG_CACHE_D1 --local --command \"CREATE TABLE IF NOT EXISTS revalidations (tag TEXT NOT NULL, revalidatedAt INTEGER NOT NULL, stale INTEGER, expire INTEGER default NULL, UNIQUE(tag) ON CONFLICT REPLACE);\"",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local && npm run db:tagcache:local && npm run db:seed:build && npm run db:seed:local",
    "admin:create": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@tiptap/core": "^3.31.0",
    "@tiptap/extension-image": "^3.31.0",
    "@tiptap/extension-table": "^3.31.0",
    "@tiptap/extension-text-align": "^3.31.0",
    "@tiptap/extensions": "^3.31.0",
    "@tiptap/pm": "^3.31.0",
    "@tiptap/react": "^3.31.0",
    "@tiptap/starter-kit": "^3.31.0",
    "@tiptap/static-renderer": "^3.31.0",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "wrangler": "^4.131.2"
  }
}

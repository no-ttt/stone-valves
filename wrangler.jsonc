{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stone-valves-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // 文章、產品、前台文字、後台帳號。
  // database_id 是佔位值：本地開發（--local）用不到；第一次部署前執行
  // `npx wrangler d1 create stone-valves-db`，把拿到的 id 填進來。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stone-valves-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle/migrations"
    },
    // 前台資料快取的「標籤清除紀錄」，跟上面是同一個資料庫（database_id 要填一樣的），
    // 見 open-next.config.ts。
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "stone-valves-db",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  // 後台上傳的圖片。正式環境要在 R2 設定公開的自訂網域（例如 img.你的網域），
  // 並把網址填進 vars 的 IMG_BASE，前台的圖片就會直接由 CDN 提供、不經過 Worker。
  // 見 docs/Cloudflare-Infra.md 第 4 節。
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "stone-valves-images"
    },
    // 前台資料快取的內容（不公開，跟圖片分開放）。第一次部署前執行
    // `npx wrangler r2 bucket create stone-valves-cache`
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "stone-valves-cache"
    }
  ],
  "vars": {
    // 正式網域，canonical、sitemap、結構化資料會用到，例如 https://www.stonevalves.com.tw
    "SITE_URL": "",
    "IMG_BASE": ""
  },

  // 上面的設定就是正式環境（production）；不加 --env 的 wrangler 指令一律作用在正式環境。
  // staging 是另一個獨立的 Worker，用 `npm run cf:deploy:staging` 部署，
  // 建置時帶 SITE_ENV=staging，所有頁面會回傳 noindex（見 next.config.ts）。
  "env": {
    "staging": {
      "name": "stone-valves-web-staging",
      "preview_urls": false,
      // binding 不會從上層繼承，env 區塊裡要完整重寫
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "stone-valves-db-staging",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "drizzle/migrations"
        },
        {
          "binding": "NEXT_TAG_CACHE_D1",
          "database_name": "stone-valves-db-staging",
          "database_id": "00000000-0000-0000-0000-000000000001"
        }
      ],
      "r2_buckets": [
        {
          "binding": "UPLOADS",
          "bucket_name": "stone-valves-images-staging"
        },
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "stone-valves-cache-staging"
        }
      ],
      "vars": {
        "SITE_URL": "",
        "IMG_BASE": "",
        "SITE_ENV": "staging"
      }
    }
  }
}
